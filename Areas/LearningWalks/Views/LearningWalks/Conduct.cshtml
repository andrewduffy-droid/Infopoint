        #enhanceWithAI {
            background: linear-gradient(45deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
        }
        
        #enhanceWithAI:hover {
            background: linear-gradient(45deg, #5a6fd8 0%, #6a4190 100%);
            color: white;
        }
        
        /* Behaviours and Attitudes Styling */
        .behaviours-checklist {
            background: var(--gray-50);
            padding: 1.5rem;
            border-radius: var(--radius);
            border: 1px solid var(--gray-200);
        }
        
        .behaviour-checkbox {
            transform: scale(1.1);
            margin-right: 0.5rem;
        }
        
        .behaviour-checkbox:checked {
            background-color: var(--brand-primary);
            border-color: var(--brand-primary);
        }
        
        .behaviours-checklist .form-check-label {
            font-size: 0.95rem;
            line-height: 1.4;
            cursor: pointer;
        }
        
        .behaviour-summary {
            border-top: 1px solid var(--gray-200);
            padding-top: 1rem;
        }
        
        .behaviour-summary .alert {
            margin-bottom: 0;
            transition: all 0.3s ease;
        }

        /* Incomplete Observation Card Styling */
        .incomplete-observation-card {
            background: var(--gray-50);
            padding: 1rem;
            border-radius: var(--radius);
            border-left: 4px solid #ffc107;
        }

        .incomplete-observation-card:last-child {
            margin-bottom: 0 !important;
        }

        .incomplete-observation-card .font-weight-medium {
            font-weight: 500;
        }
    </style>
}