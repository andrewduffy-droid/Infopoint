@model InfoPoint.Areas.LearningWalks.Models.LearningWalkAssignment

@{
    ViewData["Title"] = "Create Assignment";
}

<h1>Create Learning Walk Assignment</h1>

<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="All" class="text-danger"></div>
            <input type="hidden" name="currentTerm" value="@ViewContext.HttpContext.Request.Query["term"]" />
            
            <div class="form-group mb-3">
                <label asp-for="ObserverId" class="control-label">Observer</label>
                <select asp-for="ObserverId" class="form-control" asp-items="ViewBag.ObserverList">
                    <option value="">-- Select Observer --</option>
                </select>
                <span asp-validation-for="ObserverId" class="text-danger"></span>
            </div>
            
            <div class="form-group mb-3">
                <label asp-for="StaffId" class="control-label">Staff Member</label>
                <select asp-for="StaffId" class="form-control" asp-items="ViewBag.StaffList">
                    <option value="">-- Select Staff Member --</option>
                </select>
                <span asp-validation-for="StaffId" class="text-danger"></span>
            </div>
            
            
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}